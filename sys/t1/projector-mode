#!/bin/bash

# Switch t1's screens between mirror (TV + Dell) and dell (Dell only).
# ~/.config/hypr/monitors.lua reads the mode from the state file on reload.
# Usage: projector-mode [mirror|dell]   (no argument toggles)

STATE="$HOME/.local/state/projector-mode"
DELL="Dell Inc. DELL U2725QE G5X6PJ4"

current=$(cat "$STATE" 2>/dev/null || echo mirror)

if [[ -n $1 ]]; then
  next=$1
elif [[ $current == dell ]]; then
  next=mirror
else
  next=dell
fi

case $next in
  mirror) label="TV + Dell" ;;
  dell)
    # Disabling the TV with the Dell unplugged or off would blank both.
    if ! hyprctl monitors all -j | jq -e --arg d "$DELL" 'any(.[]; .description == $d)' >/dev/null; then
      omarchy-notification-send -g 󰍹 "Dell not connected"
      exit 1
    fi
    label="Dell only"
    ;;
  *)
    echo "Usage: $(basename "$0") [mirror|dell]" >&2
    exit 1
    ;;
esac

[[ $next == "$current" ]] && exit 0

mkdir -p "$(dirname "$STATE")"
echo "$next" >"$STATE"
hyprctl reload >/dev/null
omarchy-notification-send -g 󰍹 "$label"
