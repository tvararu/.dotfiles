[Unit]
Description=ComfyUI on-demand listener

[Socket]
# Loopback only, so tailscale serve can own the tailnet side of 8188. systemd
# accepts the connection immediately and holds it while the backend starts, so
# a cold request waits ~14s for its response instead of being refused.
ListenStream=127.0.0.1:8188

# Default, but load-bearing: systemd-socket-proxyd wants the listening socket
# itself and multiplexes every connection through one instance. Accept=yes would
# hand it an already-accepted connection and spawn a process per request.
Accept=no

[Install]
WantedBy=sockets.target
