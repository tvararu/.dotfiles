#!/bin/bash
# Port of omarchy-sudo-passwordless for sol: toggle passwordless sudo for
# MINUTES (default 15), auto-expiring via a transient systemd timer.
NOPASSWD_FILE="/etc/sudoers.d/99-nopasswd-${USER}"
TIMER_NAME="nopasswd-expire-${USER}"
MINUTES=${1:-15}
if [[ $1 && ! $1 =~ ^[0-9]+$ ]]; then echo "Usage: sudo-passwordless [MINUTES]" >&2; exit 1; fi
if sudo test -f "$NOPASSWD_FILE" && ! systemctl is-active "${TIMER_NAME}.timer" &>/dev/null; then sudo rm "$NOPASSWD_FILE"; fi
if sudo test -f "$NOPASSWD_FILE"; then
  if [[ $1 ]]; then
    sudo systemctl stop "${TIMER_NAME}.timer" 2>/dev/null
    sudo systemd-run --on-active=${MINUTES}m --timer-property=AccuracySec=1s --unit="$TIMER_NAME" rm "$NOPASSWD_FILE"
    echo "Passwordless sudo extended: disables in ${MINUTES} minutes."
  else
    sudo rm "$NOPASSWD_FILE"; sudo systemctl stop "${TIMER_NAME}.timer" 2>/dev/null
    echo "Passwordless sudo DISABLED."
  fi
else
  echo "Any process running as ${USER} gets root without a password for ${MINUTES} minutes."
  read -r -p "Enable? [y/N] " a; [[ $a == y ]] || { echo "Aborted."; exit 0; }
  echo "${USER} ALL=(ALL) NOPASSWD: ALL" | sudo tee "$NOPASSWD_FILE" >/dev/null
  sudo chmod 440 "$NOPASSWD_FILE"
  sudo systemd-run --on-active=${MINUTES}m --timer-property=AccuracySec=1s --unit="$TIMER_NAME" rm "$NOPASSWD_FILE"
  echo "Passwordless sudo ENABLED for ${MINUTES} minutes. Run again to disable early."
fi
