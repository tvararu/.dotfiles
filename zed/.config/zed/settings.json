// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "edit_predictions": {
    "provider": "zed",
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "agent": {
    "profiles": {},
    "dock": "right",
    "tool_permissions": {
      "default": "allow",
    },
    "play_sound_when_agent_done": "always",
    "inline_assistant_model": {
      "provider": "openrouter",
      "model": "openrouter/free",
    },
    "default_model": {
      "enable_thinking": false,
      "provider": "ollama",
      "model": "qwen3.8:27b-mtp-q4_K_M-d3",
    },
    "default_profile": "ask",
    "default_width": 756,
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
      "default_mode": "plan",
    },
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "fish": true,
    "git-firefly": true,
    "github-classic": true,
    "html": true,
    "ink": true,
    "ruby": true,
    "scss": true,
    "sql": true,
    "toml": true,
    "vercel-theme": true,
  },
  "base_keymap": "Atom",
  "buffer_font_family": "Iosevka Nerd Font Mono",
  "buffer_font_size": 16,
  "context_servers": {},
  "cursor_blink": false,
  "format_on_save": "on",
  "git": { "inline_blame": { "enabled": false } },
  "gutter": { "breakpoints": false, "folds": false, "runnables": false },
  "inline_code_actions": false,
  "file_types": {
    "HTML+ERB": ["tt"],
  },
  "languages": {
    "CSS": {
      "tab_size": 2,
      "language_servers": ["tailwindcss-language-server"],
    },
    "HTML": { "tab_size": 2 },
    "HTML+ERB": {
      "formatter": [
        {
          "external": { "command": "herb-format", "arguments": ["-"] },
        },
        {
          "external": {
            "command": "rufo",
            "arguments": ["--filename", "{buffer_path}", "--simple-exit"],
          },
        },
      ],
    },
    "Python": {
      "language_servers": ["pyright", "ruff"],
      "formatter": [
        { "code_action": "source.fixAll.ruff" },
        { "language_server": { "name": "ruff" } },
      ],
    },
    "Ruby": {
      "formatter": {
        "external": { "command": "rufo", "arguments": ["--simple-exit"] },
      },
      "language_servers": [
        "ruby-lsp",
        "!solargraph",
        "rubocop",
        "tailwindcss-language-server",
      ],
    },
    "SCSS": { "tab_size": 2 },
  },
  "language_models": {
    // t1 runs ollama natively on the tailnet; models unload after 5m idle.
    // The server serves 262144, but max_tokens is deliberately 65536: measured
    // time to first token is 12s at 32k, 29s at 64k, 84s at 128k and 179s at
    // 200k, so the top half of the window is batch work rather than editing.
    // The -d3 tag is the same weights with draft_num_predict 3 instead of 4:
    // 6% slower on structured output, 9% faster on prose.
    "ollama": {
      "api_url": "http://t1:11434",
      "available_models": [
        {
          "name": "qwen3.8:27b-mtp-q4_K_M-d3",
          "max_tokens": 65536,
          "supports_tools": true,
          "supports_thinking": true,
        },
        { "name": "qwen3.6:35b", "max_tokens": 32768, "supports_tools": true },
        { "name": "qwen3.5:4b", "max_tokens": 32768, "supports_tools": true },
      ],
    },
  },
  "lsp": {
    "pyright": {
      "settings": { "python.analysis": { "diagnosticMode": "workspace" } },
    },
    "tailwindcss-language-server": {
      "settings": {
        "experimental": {
          "classRegex": ["\"([^\"]*)\""], // Scan all double quoted strings
        },
      },
    },
  },
  "scrollbar": { "show": "system" },
  "terminal": {
    "default_width": 756,
    "detect_venv": "off",
    "dock": "right",
    "line_height": "standard",
    "max_scroll_history_lines": 100000,
  },
  "theme": {
    "light": "Vercel Light",
    "dark": "Vercel Dark",
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
  },
  "vim_mode": true,
  "wrap_guides": [80, 88],
}
